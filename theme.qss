/* UniVPN Light Theme - Fix for Dark Desktop Environments (KDE/Kvantum) */

/* Global text color and font */
QWidget {
    font-size: 12px;
    color: #222222;
}

/* Modal Dialog and Base Window background */
QDialog, QFrame#frame, QWidget#loginKeyUI, QWidget#MainUI {
    background-color: #f8fafc;
}

/* Ensure all labels have dark, crisp, readable text on light backgrounds */
QLabel {
    color: #1e293b !important;
    background: transparent;
}

/* Checkboxes */
QCheckBox {
    color: #1e293b !important;
    background: transparent;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #94a3b8;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #2563eb;
}

/* Input Fields (Server Address, Certificate, Password, Search box) */
QLineEdit {
    background-color: #ffffff !important;
    color: #0f172a !important;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1px solid #3b82f6;
}

/* Dropdown ComboBox (Server Address, Certificate list) */
QComboBox {
    background-color: #ffffff !important;
    color: #0f172a !important;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}
QComboBox:focus {
    border: 1px solid #3b82f6;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #cbd5e1;
    background-color: #f1f5f9;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    image: url(/home/mahdi/UniVPN/arrow-down.png);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff !important;
    color: #0f172a !important;
    selection-background-color: #dbeafe;
    selection-color: #1e40af;
    border: 1px solid #cbd5e1;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    color: #0f172a;
    background-color: #ffffff;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #eff6ff;
    color: #1d4ed8;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
}

/* Tables, Trees, Lists, Log viewers, and text areas (Fix black right panel) */
QTableWidget, QTableView, QListWidget, QListView, QTreeWidget, QTextBrowser, QTextEdit, QPlainTextEdit {
    background-color: #ffffff !important;
    color: #0f172a !important;
    border: 1px solid #e2e8f0;
    gridline-color: #f1f5f9;
    selection-background-color: #dbeafe;
    selection-color: #1e40af;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    padding: 6px;
    border: 1px solid #e2e8f0;
    font-weight: 500;
}

/* Buttons */
QToolButton, QPushButton#tb_refreshCertificate, QPushButton#tb_refreshCertificate_2 {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 2px 4px;
}
QToolButton:hover, QPushButton#tb_refreshCertificate:hover, QPushButton#tb_refreshCertificate_2:hover {
    background-color: #e2e8f0;
}
QToolButton:pressed, QPushButton#tb_refreshCertificate:pressed, QPushButton#tb_refreshCertificate_2:pressed {
    background-color: #cbd5e1;
}

QPushButton#pb_login {
    background-color: #2563eb;
    color: #ffffff !important;
    border: 1px solid #2563eb;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
    padding: 6px 16px;
}
QPushButton#pb_login:hover {
    background-color: #1d4ed8;
}
QPushButton#pb_login:pressed {
    background-color: #1e40af;
}

/* Remove hover / click / disabled background on Export & Import buttons */
QPushButton#pb_output,
QPushButton#pb_output:hover,
QPushButton#pb_output:pressed,
QPushButton#pb_output:focus,
QPushButton#pb_output:disabled,
QPushButton#pb_input,
QPushButton#pb_input:hover,
QPushButton#pb_input:pressed,
QPushButton#pb_input:focus,
QPushButton#pb_input:disabled {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    outline: none !important;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
